<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dnsSetIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:text="@string/is_dns_set"
                android:textSize="16sp" />

            <View
                android:id="@+id/dnsStatusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/dns_indicator_dot_inactive"
                android:contentDescription="@string/dns_status_indicator" />

        </LinearLayout>

        <TextView
            android:id="@+id/dnsResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/accessibilityStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openAccessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/open_accessibility_settings" />

        <TextView
            android:id="@+id/batteryStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/disableBatteryOptimizationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/disable_battery_optimization" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/password_section_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/passwordStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/setPasswordButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/set_password" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dnsScreenLockSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:checked="true"
            android:text="@string/dns_screen_lock_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dns_screen_lock_summary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dnsLockStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/unlockDnsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/unlock_dns_block" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/app_timers_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/app_timers_home_summary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/appTimersStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openAppTimersButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/manage_app_timers" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/blocked_apps_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/blockedAppNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/blocked_apps_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <Button
            android:id="@+id/addBlockedAppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/add_blocked_app" />

        <TextView
            android:id="@+id/blockedAppsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocked_apps_empty"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/blockedAppsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/blocked_sites_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/blocked_sites_summary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/blockedSiteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/blocked_sites_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1" />

        <Button
            android:id="@+id/addBlockedSiteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/add_blocked_site" />

        <TextView
            android:id="@+id/blockedSitesEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocked_sites_empty"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/blockedSitesListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/blocked_keywords_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/blocked_keywords_summary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/blockedKeywordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/blocked_keywords_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/addBlockedKeywordButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/add_blocked_keyword" />

        <TextView
            android:id="@+id/blockedKeywordsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocked_keywords_empty"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/blockedKeywordsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
